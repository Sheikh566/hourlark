ENVIRONMENT=development
AUTH_MODE=dev
APP_NAME=Hourlark
COMPANY_NAME=Example Company
COMPANY_DOMAIN=example.com
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
DEFAULT_WEEK_START=monday
ACCESS_TEAM_DOMAIN=None
ACCESS_AUD=development
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
DEV_DEFAULT_USER_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CSRF_SECRET=replace-with-a-long-random-development-only-value
# Optional browser push notifications; generate with `pnpm push:keys`. Without them the in-app
# notification inbox still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
