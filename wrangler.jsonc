{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hourlark-preview",
  "account_id": "3a985c75b283f537ddc8e728f27464af",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hourlark.sabdullah.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hourlark-preview",
      "database_id": "c1d68437-a2f0-4fae-b1a9-03393066d204",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_MODE": "google",
    "APP_NAME": "Hourlark",
    "COMPANY_NAME": "IOMechs",
    "COMPANY_DOMAIN": "iomechs.com",
    "DEFAULT_TIMEZONE": "Asia/Karachi",
    "DEFAULT_CURRENCY": "USD",
    "DEFAULT_WEEK_START": "monday",
    "ACCESS_TEAM_DOMAIN": "None",
    "ACCESS_AUD": "[Access application audience]",
    "BOOTSTRAP_ADMIN_EMAILS": "sheikh.abdullah@iomechs.com",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
